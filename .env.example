# Copy to .env to override these development-safe defaults.
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_RAW_EVENTS=raw-events
KAFKA_CONSUMER_GROUP=sentinel-detectors
KAFKA_RAW_EVENTS_PARTITIONS=6

# normal | credential-stuffing | scraping | injection | spike | mixed
SIMULATOR_MODE=mixed
SIMULATOR_RATE=25
SIMULATOR_COUNT=0
SIMULATOR_ATTACK_EVERY=40
SIMULATOR_SPIKE_MULTIPLE=10
SIMULATOR_SEED=20260814
SIMULATOR_MAX_BUFFERED=10000

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev
POSTGRES_DB=sentinel
POSTGRES_DSN=postgres://sentinel:sentinel_dev@postgres:5432/sentinel?sslmode=disable

DETECTOR_HTTP_ADDR=:8080
DETECTOR_RULES_PATH=/config/rules.yaml
DETECTOR_BATCH_SIZE=500
DETECTOR_LAG_WARNING=5000
VITE_DETECTOR_HTTP_URL=http://localhost:8080
VITE_DETECTOR_WS_URL=ws://localhost:8080/ws
